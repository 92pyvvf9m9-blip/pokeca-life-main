+.new-lottery-card.feed-card{position:relative;display:grid;gap:10px;padding:12px!important;border:1px solid #ffffff12!important;border-radius:17px!important;background:linear-gradient(145deg,#151c25,#11171e)!important;box-shadow:0 6px 20px #0002!important}
+.feed-card-main{display:grid;grid-template-columns:52px minmax(0,1fr);gap:11px;align-items:center;min-width:0}
