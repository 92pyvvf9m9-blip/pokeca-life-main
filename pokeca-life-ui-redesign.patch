+.feed-diagnostics>summary{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 12px;color:#dbe1e7;font-size:12px;font-weight:800;list-style:none;cursor:pointer}
+.feed-diagnostics>summary::-webkit-details-marker,.feed-review-group>summary::-webkit-details-marker{display:none}
+.feed-diagnostics>summary::after{content:'＋';color:var(--muted);font-size:14px}
+.feed-diagnostics[open]>summary::after{content:'−'}
+.feed-diagnostics>summary small{margin-left:auto;color:var(--muted);font-size:10px;font-weight:500}
+.feed-diagnostics-content{padding:0 10px 10px}
+.feed-diagnostics .collector-summary{margin:0 0 8px}
+.feed-diagnostics .feed-connection-notice{margin:0!important}
+.feed-count-row{display:flex;gap:8px;margin:12px 0 10px;overflow:auto}
+.feed-count-row>span{flex:0 0 auto;padding:7px 10px;border:1px solid #ffffff12;border-radius:999px;background:#ffffff05;color:var(--muted);font-size:11px;white-space:nowrap}
+.feed-count-row b{color:#f4f6f8;font-size:12px}
+#newLotteryList.stack{gap:11px}
+.feed-group{display:grid;gap:8px}
+.feed-group-head{display:flex;justify-content:space-between;align-items:center;padding:1px 2px}
