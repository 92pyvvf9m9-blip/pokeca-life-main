+/* Lottery feed and notification visual refresh */
+:root{--bg:#0a0e13;--card:#121820;--line:#29333e;--text:#f4f6f8;--muted:#aeb8c3;--p:#8662e8;--p2:#bd9bff;--ok:#4ade80;--warn:#fbbf24}
